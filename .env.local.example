# --- Discogs (primary source for vinyl search) ---
# Free personal token: https://www.discogs.com/settings/developers -> "Generate new token"
# Without a token the app still works (it automatically uses the MusicBrainz fallback),
# but Discogs search will not run.
DISCOGS_TOKEN=

# --- MusicBrainz requires a descriptive User-Agent (app name + contact) ---
MUSICBRAINZ_USER_AGENT=VinylCollection/0.1 ( you@example.com )

# --- Base site URL (used for SEO metadata, sitemap, OG tags) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (optional: enables email-OTP sign-in + cross-device sync) ---
# Without these the app runs in guest mode (collection stays in localStorage).
# Get them from Supabase → Project Settings → API. The anon key is public and
# safe in the browser (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
