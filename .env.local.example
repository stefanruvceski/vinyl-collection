# --- Discogs (primarni izvor za vinyl pretragu) ---
# Besplatan personal token: https://www.discogs.com/settings/developers -> "Generate new token"
# Bez tokena app i dalje radi (automatski koristi MusicBrainz fallback), ali Discogs pretraga nece raditi.
DISCOGS_TOKEN=

# --- MusicBrainz zahteva opisni User-Agent (ime app + kontakt) ---
MUSICBRAINZ_USER_AGENT=VinylCollection/0.1 ( you@example.com )

# --- Bazni URL sajta (koristi se za SEO metadata, sitemap, OG tagove) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
